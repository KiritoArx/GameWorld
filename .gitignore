# Roblox Studio lock files
*.rbxlx.lock
*.rbxl.lock

# Large place exports are kept out of the hub repo by default.
# Commit them deliberately from a separate game-source repo if needed.
*.rbxlx
*.rbxl

# Local/editor noise
.DS_Store
Thumbs.db
*.tmp
*.log
.env
.env.*
*.key
*.pem
*.p12
*.pfx
secrets.*
config.local.*

# Generated builds: keep the public compact hub, ignore other build output.
dist/*
!dist/
!dist/hub.compact.lua

# Adjacent local project folders
roblox_testing/
Survive-The-Apocalypse-main/
